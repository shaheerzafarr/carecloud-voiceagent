<%- include('partials/header') %>

<!-- Header with Back Button -->
<div style="margin-bottom: 24px;">
  <a href="/dashboard" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none; color: var(--text-primary); background: var(--bg-tertiary); padding: 8px 16px; border-radius: 8px; border: 1px solid var(--border-color);">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
    Back to Dashboard
  </a>
</div>

<div class="patient-detail-grid">
  <!-- Main Info Card -->
  <div class="card detail-header-card" style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; margin-bottom: 24px; display: flex; align-items: center; gap: 20px;">
    <div class="detail-avatar" style="width: 64px; height: 64px; border-radius: 50%; background: var(--accent-gradient, linear-gradient(135deg, #6366f1, #8b5cf6)); display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 700; color: white;">
      <%= (patient.first_name || '?').charAt(0) %><%= (patient.last_name || '?').charAt(0) %>
    </div>
    <div class="detail-title-group">
      <h1 class="detail-name" style="margin: 0 0 8px 0; font-size: 1.75rem;"><%= patient.first_name %> <%= patient.last_name %></h1>
      <div class="detail-meta" style="display: flex; gap: 10px; flex-wrap: wrap;">
        <span class="badge badge-info" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; padding: 4px 10px; border-radius: 6px; font-size: 0.85rem; font-family: monospace;">ID: <%= patient.patient_id %></span>
        <span class="badge badge-primary" style="background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 4px 10px; border-radius: 6px; font-size: 0.85rem;">Registered via Voice AI</span>
      </div>
    </div>
  </div>

  <!-- Personal & Contact Info -->
  <div class="card" style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; margin-bottom: 24px;">
    <div class="card-header" style="margin-bottom: 16px;">
      <h2 class="card-title" style="margin: 0; font-size: 1.25rem;">Demographic Information</h2>
    </div>
    <div class="card-body">
      <div class="info-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
        <div class="info-item">
          <span class="info-label" style="display: block; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 4px;">Date of Birth</span>
          <span class="info-value" style="font-weight: 600;"><%= patient.date_of_birth ? new Date(patient.date_of_birth).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'N/A' %></span>
        </div>
        <div class="info-item">
          <span class="info-label" style="display: block; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 4px;">Biological Sex</span>
          <span class="info-value" style="font-weight: 600;"><%= patient.sex %></span>
        </div>
        <div class="info-item">
          <span class="info-label" style="display: block; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 4px;">Phone Number</span>
          <span class="info-value" style="font-weight: 600;"><%= (patient.phone_number || '').replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3') %></span>
        </div>
        <div class="info-item">
          <span class="info-label" style="display: block; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 4px;">Email Address</span>
          <span class="info-value" style="font-weight: 600;"><%= patient.email || 'N/A' %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Address -->
  <div class="card" style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; margin-bottom: 24px;">
    <div class="card-header" style="margin-bottom: 16px;">
      <h2 class="card-title" style="margin: 0; font-size: 1.25rem;">Residential Address</h2>
    </div>
    <div class="card-body">
      <div class="info-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
        <div class="info-item" style="grid-column: span 2;">
          <span class="info-label" style="display: block; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 4px;">Street Address</span>
          <span class="info-value" style="font-weight: 600;"><%= patient.address_line_1 || patient.address_line1 || 'N/A' %><%= patient.address_line_2 ? ', ' + patient.address_line_2 : '' %></span>
        </div>
        <div class="info-item">
          <span class="info-label" style="display: block; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 4px;">City</span>
          <span class="info-value" style="font-weight: 600;"><%= patient.city %></span>
        </div>
        <div class="info-item">
          <span class="info-label" style="display: block; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 4px;">State</span>
          <span class="info-value" style="font-weight: 600;"><%= patient.state %></span>
        </div>
        <div class="info-item">
          <span class="info-label" style="display: block; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 4px;">ZIP Code</span>
          <span class="info-value" style="font-weight: 600;"><%= patient.zip_code %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Emergency Contact & Preferences -->
  <div class="card" style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; margin-bottom: 24px;">
    <div class="card-header" style="margin-bottom: 16px;">
      <h2 class="card-title" style="margin: 0; font-size: 1.25rem;">Emergency Contact & Preferences</h2>
    </div>
    <div class="card-body">
      <div class="info-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
        <div class="info-item">
          <span class="info-label" style="display: block; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 4px;">Emergency Contact</span>
          <span class="info-value" style="font-weight: 600;"><%= patient.emergency_contact_name || 'None provided' %></span>
        </div>
        <div class="info-item">
          <span class="info-label" style="display: block; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 4px;">Emergency Phone</span>
          <span class="info-value" style="font-weight: 600;"><%= patient.emergency_contact_phone ? patient.emergency_contact_phone.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3') : 'N/A' %></span>
        </div>
        <div class="info-item">
          <span class="info-label" style="display: block; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 4px;">Preferred Language</span>
          <span class="info-value" style="font-weight: 600;"><%= patient.preferred_language || 'English' %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Insurance Info -->
  <div class="card" style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; margin-bottom: 24px;">
    <div class="card-header" style="margin-bottom: 16px;">
      <h2 class="card-title" style="margin: 0; font-size: 1.25rem;">Insurance Information</h2>
    </div>
    <div class="card-body">
      <div class="info-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
        <div class="info-item">
          <span class="info-label" style="display: block; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 4px;">Provider</span>
          <span class="info-value" style="font-weight: 600;"><%= patient.insurance_provider || 'Self-Pay / None' %></span>
        </div>
        <div class="info-item">
          <span class="info-label" style="display: block; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 4px;">Member / Subscriber ID</span>
          <span class="info-value" style="font-weight: 600;"><%= patient.insurance_member_id || 'N/A' %></span>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Appointments Section -->
<% const patientAppts = (typeof appointments !== 'undefined' && appointments) || patient.appointments || []; %>
<% if (patientAppts && patientAppts.length > 0) { %>
  <div class="card" style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; margin-bottom: 24px;">
    <div class="card-header" style="margin-bottom: 16px;">
      <h2 class="card-title" style="margin: 0; font-size: 1.25rem;">Scheduled Appointments</h2>
    </div>
    <div class="card-body p-0">
      <div class="table-container">
        <table class="data-table">
          <thead>
            <tr>
              <th>Date & Time</th>
              <th>Type</th>
              <th>Provider</th>
              <th>Notes</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% patientAppts.forEach(apt => { %>
              <tr>
                <td><strong><%= new Date(apt.date || apt.appointment_date).toLocaleDateString() %> <%= apt.time || '' %></strong></td>
                <td><span class="badge badge-info"><%= apt.type || apt.appointment_type || 'new_patient' %></span></td>
                <td><%= apt.provider || 'Dr. Smith' %></td>
                <td><%= apt.notes || 'Routine Checkup' %></td>
                <td><span class="badge badge-success"><%= apt.status || 'scheduled' %></span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
<% } %>

<!-- Call Logs Section -->
<% const patientCalls = (typeof callLogs !== 'undefined' && callLogs) || patient.call_logs || []; %>
<% if (patientCalls && patientCalls.length > 0) { %>
  <div class="card" style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; margin-bottom: 24px;">
    <div class="card-header" style="margin-bottom: 16px;">
      <h2 class="card-title" style="margin: 0; font-size: 1.25rem;">Call Transcripts & History</h2>
    </div>
    <div class="card-body">
      <% patientCalls.forEach(call => { %>
        <div style="border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 16px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <span class="badge badge-primary">Call ID: <%= call.call_id || call.vapi_call_id %></span>
            <span class="text-muted" style="font-size: 0.85rem;"><%= new Date(call.created_at || call.createdAt || Date.now()).toLocaleString() %> (<%= call.duration_seconds || 0 %>s)</span>
          </div>
          <% if (call.summary) { %>
            <p style="margin-bottom: 8px; font-size: 0.9rem; color: var(--text-secondary);"><strong>Summary:</strong> <%= call.summary %></p>
          <% } %>
          <div style="background: var(--bg-tertiary); padding: 12px; border-radius: 8px; font-family: monospace; font-size: 0.85rem; white-space: pre-wrap; max-height: 200px; overflow-y: auto;">
            <%= call.transcript || 'No transcript recorded.' %>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
