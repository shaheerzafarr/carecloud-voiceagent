<%- include('layout', { body: `
  <!-- Header with Back Button -->
  <div style="margin-bottom: 24px;">
    <a href="/dashboard" class="btn btn-secondary" style="display: inline-flex; align-items: center; gap: 8px;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      Back to Dashboard
    </a>
  </div>

  <div class="patient-detail-grid">
    <!-- Main Info Card -->
    <div class="card detail-header-card">
      <div class="detail-avatar">
        ${patient.first_name.charAt(0)}${patient.last_name.charAt(0)}
      </div>
      <div class="detail-title-group">
        <h1 class="detail-name">${patient.first_name} ${patient.middle_name ? patient.middle_name + ' ' : ''}${patient.last_name}</h1>
        <div class="detail-meta">
          <span class="badge badge-info">ID: ${patient.patient_id}</span>
          <span class="badge ${patient.is_active ? 'badge-success' : 'badge-danger'}">
            ${patient.is_active ? 'Active' : 'Inactive'}
          </span>
          <span class="badge badge-primary">Registered via ${patient.registered_via || 'Voice AI'}</span>
        </div>
      </div>
    </div>

    <!-- Personal & Contact Info -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Demographic Information</h2>
      </div>
      <div class="card-body">
        <div class="info-grid">
          <div class="info-item">
            <span class="info-label">Date of Birth</span>
            <span class="info-value">${patient.date_of_birth}</span>
          </div>
          <div class="info-item">
            <span class="info-label">Biological Sex</span>
            <span class="info-value">${patient.sex}</span>
          </div>
          <div class="info-item">
            <span class="info-label">Phone Number</span>
            <span class="info-value">${patient.phone_number}</span>
          </div>
          <div class="info-item">
            <span class="info-label">Email Address</span>
            <span class="info-value">${patient.email || 'N/A'}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Address -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Residential Address</h2>
      </div>
      <div class="card-body">
        <div class="info-grid">
          <div class="info-item" style="grid-column: span 2;">
            <span class="info-label">Street Address</span>
            <span class="info-value">${patient.address_line1}${patient.address_line2 ? ', ' + patient.address_line2 : ''}</span>
          </div>
          <div class="info-item">
            <span class="info-label">City</span>
            <span class="info-value">${patient.city}</span>
          </div>
          <div class="info-item">
            <span class="info-label">State</span>
            <span class="info-value">${patient.state}</span>
          </div>
          <div class="info-item">
            <span class="info-label">ZIP Code</span>
            <span class="info-value">${patient.zip_code}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Emergency Contact -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Emergency Contact</h2>
      </div>
      <div class="card-body">
        <div class="info-grid">
          <div class="info-item">
            <span class="info-label">Contact Name</span>
            <span class="info-value">${patient.emergency_contact_name || 'N/A'}</span>
          </div>
          <div class="info-item">
            <span class="info-label">Relationship</span>
            <span class="info-value">${patient.emergency_contact_relationship || 'N/A'}</span>
          </div>
          <div class="info-item" style="grid-column: span 2;">
            <span class="info-label">Phone Number</span>
            <span class="info-value">${patient.emergency_contact_phone || 'N/A'}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Insurance Info -->
    <div class="card">
      <div class="card-header">
        <h2 class="card-title">Insurance Details</h2>
      </div>
      <div class="card-body">
        <div class="info-grid">
          <div class="info-item">
            <span class="info-label">Insurance Provider</span>
            <span class="info-value">${patient.insurance_provider || 'Self-Pay / None'}</span>
          </div>
          <div class="info-item">
            <span class="info-label">Policy Number</span>
            <span class="info-value">${patient.insurance_policy_number || 'N/A'}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Appointments Section -->
  <% if (patient.appointments && patient.appointments.length > 0) { %>
    <div class="card" style="margin-top: 24px;">
      <div class="card-header">
        <h2 class="card-title">Scheduled Appointments</h2>
      </div>
      <div class="card-body p-0">
        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Date & Time</th>
                <th>Type</th>
                <th>Provider</th>
                <th>Reason</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% patient.appointments.forEach(apt => { %>
                <tr>
                  <td><strong><%= new Date(apt.appointment_date).toLocaleString() %></strong></td>
                  <td><span class="badge badge-info"><%= apt.appointment_type %></span></td>
                  <td><%= apt.provider_name %></td>
                  <td><%= apt.reason || 'Routine Checkup' %></td>
                  <td><span class="badge badge-success"><%= apt.status %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Call Logs Section -->
  <% if (patient.call_logs && patient.call_logs.length > 0) { %>
    <div class="card" style="margin-top: 24px;">
      <div class="card-header">
        <h2 class="card-title">Call Transcripts & Audio</h2>
      </div>
      <div class="card-body">
        <% patient.call_logs.forEach(call => { %>
          <div style="border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 16px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
              <span class="badge badge-primary">Call ID: <%= call.vapi_call_id %></span>
              <span class="text-muted" style="font-size: 0.85rem;"><%= new Date(call.created_at).toLocaleString() %> (${call.duration_seconds || 0}s)</span>
            </div>
            <% if (call.recording_url) { %>
              <div style="margin: 8px 0;">
                <audio controls src="<%= call.recording_url %>" style="width: 100%; max-width: 400px; height: 36px;"></audio>
              </div>
            <% } %>
            <div style="background: var(--bg-tertiary); padding: 12px; border-radius: 8px; font-family: monospace; font-size: 0.85rem; white-space: pre-wrap; max-height: 200px; overflow-y: auto;">
              <%= call.transcript || 'No transcript recorded.' %>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>
` }) %>
